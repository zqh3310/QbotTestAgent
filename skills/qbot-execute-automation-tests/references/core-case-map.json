      "id": "CORE-TEXT-001",
      "suite": "core",
      "runner": "ui-agent-run",
      "priority": "P0",
      "title": "普通问候应自然回复且无内部技术噪音",
      "must_run_reason": "核心对话入口是 QBot 第一价值点，每轮必须验证基础问答可用。"
    },
    {
      "id": "CORE-CONTEXT-002",
      "suite": "core",
      "runner": "ui-agent-run",
      "priority": "P0",
      "title": "多轮上下文应记住业务数字并完成计算",
      "must_run_reason": "非技术用户通常在一个会话内连续追问，必须验证上下文延续。"
